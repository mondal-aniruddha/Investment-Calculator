meta {
  name: Calculate SIP
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/investing/sip
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "monthlyInvestment": 5000,
    "investmentHorizonYears": 10,
    "expectedAnnualReturn": 12,
    "annualStepUpPercent": 10,
    "riskProfile": "MODERATE"
  }
}
