# InFinance Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# DO NOT commit .env.local to git.
#
# Vite env var rules:
#  - Variables prefixed VITE_ are exposed to client-side code.
#  - Variables WITHOUT the VITE_ prefix are build-time only (never in the bundle).
#  - See src/shared/lib/config.js for the canonical list of all VITE_ vars.

# ─── API ────────────────────────────────────────────────────────────────────
# Base URL of the Spring Boot backend (leave blank to use the Vite dev proxy).
# In production set to your deployed API URL, e.g. https://api.infinance.example.com
VITE_API_BASE_URL=

# ─── BUILD-TIME PROXY ────────────────────────────────────────────────────────
# Backend URL used by the Vite dev-server and preview proxy only.
# Not exposed to the browser bundle. Default: http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080

# ─── APP METADATA ───────────────────────────────────────────────────────────
# Injected by CI; the app falls back to the version in package.json.
# VITE_APP_VERSION=2.0.0

# Override environment label for staging deployments.
# Values: development | staging | production
# VITE_APP_ENV=development

# ─── OWNER CONTACT DETAILS (legacy, founder only) ───────────────────────────
# Default values used as fallback if backend /api/v1/config/owner-contact is unreachable
VITE_OWNER_NAME=Aniruddha Mondal
VITE_OWNER_WHATSAPP=+91 8013292565
VITE_OWNER_EMAIL=aniruddha0266@gmail.com

# ─── TEAM MEMBERS ────────────────────────────────────────────────────────────
# Used as fallback when GET /api/v1/config/team is unreachable.
# Built-in defaults are configured in code; specify below only to override.
# Index 0 = founder, Index 1 = co-founder.
VITE_TEAM_0_NAME=Aniruddha Mondal
VITE_TEAM_0_ROLE=Founder & Lead Developer
VITE_TEAM_0_WHATSAPP=+91 8013292565
VITE_TEAM_0_EMAIL=aniruddha0266@gmail.com
VITE_TEAM_0_INITIALS=AM
# VITE_TEAM_0_SHORT_BIO=Optional override for founder bio
VITE_TEAM_1_NAME=Kuhika Das
VITE_TEAM_1_ROLE=Co-founder & Process Engineer
VITE_TEAM_1_WHATSAPP=+91 7667889389
VITE_TEAM_1_EMAIL=kuhika.das@gmail.com
VITE_TEAM_1_INITIALS=KD
# VITE_TEAM_1_SHORT_BIO=Optional override for co-founder bio
