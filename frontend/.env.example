# InFinance Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# DO NOT commit .env.local to git.
#
# Vite env var rules:
#  - Variables prefixed VITE_ are exposed to client-side code.
#  - Variables WITHOUT the VITE_ prefix are build-time only (never in the bundle).
#  - See src/shared/lib/config.js for the canonical list of all VITE_ vars.

# ─── API ────────────────────────────────────────────────────────────────────
# Base URL of the Spring Boot backend (leave blank to use the Vite dev proxy).
# In production set to your deployed API URL, e.g. https://api.infinance.example.com
VITE_API_BASE_URL=

# ─── BUILD-TIME PROXY ────────────────────────────────────────────────────────
# Backend URL used by the Vite dev-server and preview proxy only.
# Not exposed to the browser bundle. Default: http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080

# ─── APP METADATA ───────────────────────────────────────────────────────────
# Injected by CI; the app falls back to the version in package.json.
# VITE_APP_VERSION=2.0.0

# Override environment label for staging deployments.
# Values: development | staging | production
# VITE_APP_ENV=development

# ─── OWNER CONTACT DETAILS ──────────────────────────────────────────────────
# Default values used as fallback if backend /api/v1/config/owner-contact is unreachable
VITE_OWNER_NAME=Aniruddha Mondal
VITE_OWNER_PHONE=+91 98765 43210
VITE_OWNER_EMAIL=aniruddha.mondal@example.com
