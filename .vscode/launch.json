{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Backend: Spring Boot App",
            "request": "launch",
            "mainClass": "com.infinance.InFinanceCalculatorApplication",
            "projectName": "infinance-calculator-backend",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "SPRING_PROFILES_ACTIVE": "dev"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Frontend: Vite Dev",
            "cwd": "${workspaceFolder}/frontend",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"]
        }
    ]
}