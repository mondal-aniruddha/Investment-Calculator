# Copy to .env for local Docker Compose. Never commit the populated file.
MYSQL_USER=infinance
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
INFINANCE_JWT_SECRET=replace-with-at-least-32-random-bytes
INFINANCE_ADMIN_USERNAME=admin
INFINANCE_ADMIN_PASSWORD=replace-with-an-admin-password
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,https://infinance-home.netlify.app
INFINANCE_METALS_PROVIDER=metals-dev
INFINANCE_METALS_API_KEY=replace-with-metals-dev-api-key
INFINANCE_METALS_BASE_URL=https://api.metals.dev
INFINANCE_METALS_AUTHORITY=mcx
INFINANCE_METALS_BASE_CURRENCY=INR
INFINANCE_METALS_UNIT=g
INFINANCE_OWNER_NAME=Aniruddha Mondal
INFINANCE_OWNER_WHATSAPP=+91 8013292565
INFINANCE_OWNER_EMAIL=aniruddha0266@gmail.com
# Team members (index 0 = founder, index 1 = co-founder; defaults configured in yml)
INFINANCE_TEAM_0_NAME=Aniruddha Mondal
INFINANCE_TEAM_0_ROLE=Founder & Lead Developer
INFINANCE_TEAM_0_WHATSAPP=+91 8013292565
INFINANCE_TEAM_0_EMAIL=aniruddha0266@gmail.com
INFINANCE_TEAM_0_INITIALS=AM
# INFINANCE_TEAM_0_SHORT_BIO=Optional override for founder bio
INFINANCE_TEAM_1_NAME=Kuhika Das
INFINANCE_TEAM_1_ROLE=Co-founder & Process Engineer
INFINANCE_TEAM_1_WHATSAPP=+91 7667889389
INFINANCE_TEAM_1_EMAIL=kuhika.das@gmail.com
INFINANCE_TEAM_1_INITIALS=KD
# INFINANCE_TEAM_1_SHORT_BIO=Optional override for co-founder bio
INFINANCE_QUERIES_NOTIFY_ENABLED=false
INFINANCE_QUERIES_RECIPIENT_EMAIL=aniruddha0266@gmail.com

# OTP & Two-Factor Authentication Configuration
INFINANCE_OTP_ENABLED=true
INFINANCE_OTP_PROVIDER=dev
INFINANCE_OTP_SECRET=replace-with-at-least-32-chars-random-secret-key
INFINANCE_OTP_CODE_LENGTH=6
INFINANCE_OTP_TTL_SECONDS=300
INFINANCE_OTP_MAX_ATTEMPTS=5
INFINANCE_OTP_RESEND_COOLDOWN_SECONDS=60
INFINANCE_OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
INFINANCE_OTP_ALLOWED_COUNTRY_CODES=+91

# Twilio SMS & WhatsApp Provider (required when INFINANCE_OTP_PROVIDER=twilio)
INFINANCE_TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
INFINANCE_TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
INFINANCE_TWILIO_SMS_FROM=replace-with-twilio-sms-phone-or-service
INFINANCE_TWILIO_WHATSAPP_FROM=+14155238886
INFINANCE_TWILIO_WHATSAPP_CONTENT_SID=replace-with-approved-content-sid-or-blank
