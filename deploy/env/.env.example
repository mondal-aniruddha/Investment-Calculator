# Copy to .env for local Docker Compose. Never commit the populated file.
MYSQL_USER=infinance
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
INFINANCE_JWT_SECRET=replace-with-at-least-32-random-bytes
INFINANCE_ADMIN_USERNAME=admin
INFINANCE_ADMIN_PASSWORD=replace-with-an-admin-password
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,https://infinance-home.netlify.app
INFINANCE_METALS_PROVIDER=metals-dev
INFINANCE_METALS_API_KEY=replace-with-metals-dev-api-key
INFINANCE_METALS_BASE_URL=https://api.metals.dev
INFINANCE_METALS_AUTHORITY=mcx
INFINANCE_METALS_BASE_CURRENCY=INR
INFINANCE_METALS_UNIT=g
